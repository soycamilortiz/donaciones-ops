{
  "name": "@soschoco/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Contratos de dominio compartidos entre el API y los fronts",
  "license": "UNLICENSED",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/emit-module-markers.mjs",
    "dev": "pnpm build && tsc -p tsconfig.esm.json --watch --preserveWatchOutput",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
