/// Kit físico (o identidad armada) a partir de una reserva. Picking aún no descuenta stock.
model KitInstancia {
  id             String             @id @default(uuid()) @db.Uuid
  codigo         String
  organizationId String             @map("organization_id") @db.Uuid
  acopioId       String             @map("acopio_id") @db.Uuid
  demandaId      String             @map("demanda_id") @db.Uuid
  reservaId      String             @map("reserva_id") @db.Uuid
  kitId                  String             @map("kit_id") @db.Uuid
  zonaKittingUbicacionId String?            @map("zona_kitting_ubicacion_id") @db.Uuid
  estado                 KitInstanciaEstado @default(PENDIENTE_PICK)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio       Acopio       @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  demanda      Demanda      @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  reserva      Reserva      @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  kit          Kit          @relation(fields: [kitId], references: [id], onDelete: Restrict)
