  destinoNombre   String                  @map("destino_nombre")
  estado          PlanPalletizacionEstado @default(ACTIVO)
  kitPesoKg       Decimal                 @default(20) @map("kit_peso_kg") @db.Decimal(14, 3)
  palletPesoMaxKg Decimal                 @default(800) @map("pallet_peso_max_kg") @db.Decimal(14, 3)
  kitAltoM        Decimal?                @map("kit_alto_m") @db.Decimal(8, 3)
  palletAltoMaxM  Decimal?                @map("pallet_alto_max_m") @db.Decimal(8, 3)
  palletCount     Int                     @map("pallet_count")
  kitsPorPallet   Int                     @map("kits_por_pallet")
  createdById     String                  @map("created_by_id") @db.Uuid
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio        Acopio           @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  demanda       Demanda          @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  consolidacion Consolidacion    @relation(fields: [consolidacionId], references: [id], onDelete: Restrict)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  slots         PlanPalletSlot[]
  pallets       PalletDespacho[]
  despachos     Despacho[]

  @@unique([organizationId, codigo])
  @@index([demandaId, estado])
  @@map("planes_palletizacion")
}

model PlanPalletSlot {
  id            String   @id @default(uuid()) @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  sequence      Int
  kitsObjetivo  Int      @map("kits_objetivo")
  pesoTeoricoKg Decimal  @map("peso_teorico_kg") @db.Decimal(14, 3)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  plan   PlanPalletizacion @relation(fields: [planId], references: [id], onDelete: Restrict)
  pallet PalletDespacho?

  @@unique([planId, sequence])
  @@index([planId])
  @@map("plan_pallet_slots")
}

/// Unidad logística de despacho (estiba física outbound).
model PalletDespacho {
  id              String               @id @default(uuid()) @db.Uuid
  codigo          String
  organizationId  String               @map("organization_id") @db.Uuid
  acopioId        String               @map("acopio_id") @db.Uuid
  demandaId       String               @map("demanda_id") @db.Uuid
  planId          String               @map("plan_id") @db.Uuid
  slotId          String               @unique @map("slot_id") @db.Uuid
  consolidacionId String               @map("consolidacion_id") @db.Uuid
  despachoId      String?              @map("despacho_id") @db.Uuid
  destinoNombre   String               @map("destino_nombre")
  sequence        Int
  estado          PalletDespachoEstado @default(CREADO)
  kitsObjetivo    Int                  @map("kits_objetivo")
  pesoPalletKg    Decimal              @default(25) @map("peso_pallet_kg") @db.Decimal(14, 3)
  pesoNetoKg      Decimal?             @map("peso_neto_kg") @db.Decimal(14, 3)
  pesoBrutoKg     Decimal?             @map("peso_bruto_kg") @db.Decimal(14, 3)
  altoM           Decimal?             @map("alto_m") @db.Decimal(8, 3)
  anchoM          Decimal?             @map("ancho_m") @db.Decimal(8, 3)
  largoM          Decimal?             @map("largo_m") @db.Decimal(8, 3)
  finalizadoAt    DateTime?            @map("finalizado_at")
  createdById     String               @map("created_by_id") @db.Uuid
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio        Acopio               @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  demanda       Demanda              @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  plan          PlanPalletizacion    @relation(fields: [planId], references: [id], onDelete: Restrict)
  slot          PlanPalletSlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  despacho      Despacho?            @relation(fields: [despachoId], references: [id], onDelete: SetNull)
  cargaItem       CargaItem?
  viajeParadaLink ViajeParadaPallet?
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items         PalletDespachoItem[]

  @@unique([organizationId, codigo])
  @@index([planId, estado])
  @@index([despachoId])
  @@map("pallets_despacho")
}

model PalletDespachoItem {
  id               String                 @id @default(uuid()) @db.Uuid
  palletDespachoId String                 @map("pallet_despacho_id") @db.Uuid
  tipo             PalletDespachoItemTipo @default(KIT)
  kitInstanciaId   String?                @map("kit_instancia_id") @db.Uuid
  productoId       String?                @map("producto_id") @db.Uuid
  cantidad         Decimal?               @db.Decimal(14, 3)
  escaneadoAt      DateTime?              @map("escaneado_at")
  escaneadoPorId   String?                @map("escaneado_por_id") @db.Uuid
  retiradoAt       DateTime?              @map("retirado_at")
  retiradoMotivo   String?                @map("retirado_motivo")
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")

  palletDespacho PalletDespacho @relation(fields: [palletDespachoId], references: [id], onDelete: Restrict)
  kitInstancia   KitInstancia?  @relation(fields: [kitInstanciaId], references: [id], onDelete: Restrict)
  producto       Producto?      @relation(fields: [productoId], references: [id], onDelete: Restrict)
  escaneadoPor   User?          @relation("PalletItemEscaneadoPor", fields: [escaneadoPorId], references: [id], onDelete: SetNull)

  @@index([palletDespachoId, isActive])
  @@index([kitInstanciaId])
  @@map("pallet_despacho_items")
}

/// Expedición outbound: necesidad logística de salida (puede tener varios viajes).
model Despacho {
  id                  String           @id @default(uuid()) @db.Uuid
  codigo              String
  organizationId      String           @map("organization_id") @db.Uuid
  acopioId            String           @map("acopio_id") @db.Uuid
  demandaId           String           @map("demanda_id") @db.Uuid
  planId              String           @map("plan_id") @db.Uuid
  destinoNombre       String           @map("destino_nombre")
  estado              DespachoEstado   @default(BORRADOR)
  prioridad           DemandaPrioridad @default(MEDIA)
  palletsEsperados    Int              @map("pallets_esperados")
  kitsEsperados       Int              @default(0) @map("kits_esperados")
  palletsDespachados  Int              @default(0) @map("pallets_despachados")
  kitsDespachados     Int              @default(0) @map("kits_despachados")
  pesoTotalKg         Decimal?         @map("peso_total_kg") @db.Decimal(14, 3)
  volumenTotalM3      Decimal?         @map("volumen_total_m3") @db.Decimal(14, 3)
  esParcial           Boolean          @default(false) @map("es_parcial")
  vehiculoPlaca       String?          @map("vehiculo_placa")
  transportista       String?
  conductorNombre     String?          @map("conductor_nombre")
  conductorDocumento  String?          @map("conductor_documento")
  documentoTransporte String?        @map("documento_transporte")
  observaciones       String?
  salidaProgramada    DateTime?        @map("salida_programada")
  salidaReal          DateTime?        @map("salida_real")
  createdById         String           @map("created_by_id") @db.Uuid
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio       Acopio            @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  demanda      Demanda           @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  plan         PlanPalletizacion @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  pallets      PalletDespacho[]
  viajes       Viaje[]
  cargas       Carga[]
  movimientos  InventoryMovimiento[]
  manifiesto   DespachoManifiesto?
  checklist    DespachoChecklist?
  pods         ProofOfDelivery[]

  @@unique([organizationId, codigo])
  @@index([demandaId, estado])
  @@index([planId])
  @@map("despachos")
}

model Transportista {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  nombre         String
  tipo           TransportistaTipo  @default(EMPRESA)
  documento      String?
  nit            String?
  contacto       String?
  telefono       String?
  email          String?
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  viajes       Viaje[]
  vehiculos    Vehiculo[]
  conductores  Conductor[]

  @@index([organizationId, isActive])
  @@map("transportistas")
}

model Vehiculo {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  transportistaId String?         @map("transportista_id") @db.Uuid
  placa           String
  tipo            String?
  marca           String?
  modelo          String?
  capacidadKg     Decimal?        @map("capacidad_kg") @db.Decimal(14, 3)
  capacidadM3     Decimal?        @map("capacidad_m3") @db.Decimal(14, 3)
  numEjes         Int?            @map("num_ejes")
  estado          VehiculoEstado  @default(DISPONIBLE)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transportista Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  viajes        Viaje[]

  @@unique([organizationId, placa])
  @@index([organizationId, isActive])
  @@index([transportistaId])
  @@map("vehiculos")
}

model Conductor {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  transportistaId String?  @map("transportista_id") @db.Uuid
  nombre          String
  documento       String
  telefono        String?
  licencia        String?
  tipoLicencia    String?  @map("tipo_licencia")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transportista Transportista? @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  viajes        Viaje[]

  @@unique([organizationId, documento])
  @@index([organizationId, isActive])
  @@index([transportistaId])
  @@map("conductores")
}

model Ruta {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  codigo         String
  nombre         String
  descripcion    String?
  createdById    String   @map("created_by_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  paradas      RutaParada[]
  viajes       Viaje[]

  @@unique([organizationId, codigo])
  @@index([organizationId, isActive])
  @@map("rutas")
}

model RutaParada {
  id             String   @id @default(uuid()) @db.Uuid
  rutaId         String   @map("ruta_id") @db.Uuid
  sequence       Int
  nombre         String
  destinoNombre  String?  @map("destino_nombre")
  lat            Float?
  lng            Float?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  ruta Ruta @relation(fields: [rutaId], references: [id], onDelete: Restrict)

  @@unique([rutaId, sequence])
  @@index([rutaId, isActive])
  @@map("ruta_paradas")
}

/// Movimiento físico con vehículo (puede haber varios por despacho).
model Viaje {
  id                  String      @id @default(uuid()) @db.Uuid
  codigo              String
  organizationId      String      @map("organization_id") @db.Uuid
  acopioId            String      @map("acopio_id") @db.Uuid
  despachoId          String      @map("despacho_id") @db.Uuid
  rutaId              String?     @map("ruta_id") @db.Uuid
  vehiculoId          String?     @map("vehiculo_id") @db.Uuid
  transportistaId     String?     @map("transportista_id") @db.Uuid
  conductorId         String?     @map("conductor_id") @db.Uuid
  vehiculoPlaca       String?     @map("vehiculo_placa")
  transportistaNombre String?     @map("transportista_nombre")
  conductorNombre     String?     @map("conductor_nombre")
  conductorDocumento  String?     @map("conductor_documento")
  origenNombre        String?     @map("origen_nombre")
  destinoNombre       String?     @map("destino_nombre")
  estado              ViajeEstado @default(PLANIFICADO)
  palletsEsperados    Int         @map("pallets_esperados")
  palletsCargados     Int         @default(0) @map("pallets_cargados")
  kitsEsperados       Int         @default(0) @map("kits_esperados")
  kitsCargados        Int         @default(0) @map("kits_cargados")
  pesoCargadoKg       Decimal     @default(0) @map("peso_cargado_kg") @db.Decimal(14, 3)
  volumenM3           Decimal?    @map("volumen_m3") @db.Decimal(14, 3)
  salidaProgramada    DateTime?   @map("salida_programada")
  salidaReal          DateTime?   @map("salida_real")
  llegadaEstimada     DateTime?   @map("llegada_estimada")
  llegadaReal         DateTime?   @map("llegada_real")
  observaciones       String?
  createdById         String      @map("created_by_id") @db.Uuid
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio        Acopio            @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  despacho      Despacho          @relation(fields: [despachoId], references: [id], onDelete: Restrict)
  ruta          Ruta?             @relation(fields: [rutaId], references: [id], onDelete: SetNull)
  vehiculo      Vehiculo?         @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  transportista Transportista?    @relation(fields: [transportistaId], references: [id], onDelete: SetNull)
  conductor     Conductor?        @relation(fields: [conductorId], references: [id], onDelete: SetNull)
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  carga         Carga?
  paradas       ViajeParada[]
  eventos       TransportEvent[]
  pod           ProofOfDelivery?
  movimientos   InventoryMovimiento[]

  @@unique([organizationId, codigo])
  @@index([despachoId, estado])
  @@index([organizationId, estado])
  @@map("viajes")
}

model ViajeParada {
  id            String            @id @default(uuid()) @db.Uuid
  viajeId       String            @map("viaje_id") @db.Uuid
  sequence      Int
  nombre        String
  destinoNombre String?           @map("destino_nombre")
  estado        ViajeParadaEstado @default(PENDIENTE)
  llegadaAt     DateTime?         @map("llegada_at")
  salidaAt      DateTime?         @map("salida_at")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")

  viaje   Viaje               @relation(fields: [viajeId], references: [id], onDelete: Restrict)
  pallets ViajeParadaPallet[]

  @@unique([viajeId, sequence])
  @@index([viajeId, isActive])
  @@map("viaje_paradas")
}

model ViajeParadaPallet {
  id               String   @id @default(uuid()) @db.Uuid
  viajeParadaId    String   @map("viaje_parada_id") @db.Uuid
  palletDespachoId String   @unique @map("pallet_despacho_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  viajeParada    ViajeParada    @relation(fields: [viajeParadaId], references: [id], onDelete: Restrict)
  palletDespacho PalletDespacho @relation(fields: [palletDespachoId], references: [id], onDelete: Restrict)

  @@index([viajeParadaId, isActive])
  @@map("viaje_parada_pallets")
}

model TransportEvent {
  id              String             @id @default(uuid()) @db.Uuid
  viajeId         String             @map("viaje_id") @db.Uuid
  tipo            TransportEventTipo
  fechaHora       DateTime           @map("fecha_hora")
  ubicacionNombre String?            @map("ubicacion_nombre")
  observaciones   String?
  createdById     String             @map("created_by_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")

  viaje     Viaje @relation(fields: [viajeId], references: [id], onDelete: Restrict)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([viajeId, fechaHora])
  @@map("transport_events")
}

/// Contenido físico que va en un viaje (pallets, cajas, etc.).
model Carga {
  id             String      @id @default(uuid()) @db.Uuid
  viajeId        String      @unique @map("viaje_id") @db.Uuid
  despachoId     String      @map("despacho_id") @db.Uuid
  estado         CargaEstado @default(ABIERTA)
  palletsEsperados Int       @map("pallets_esperados")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  viaje    Viaje       @relation(fields: [viajeId], references: [id], onDelete: Restrict)
  despacho Despacho    @relation(fields: [despachoId], references: [id], onDelete: Restrict)
  items    CargaItem[]

  @@index([despachoId])
  @@map("cargas")
}

model CargaItem {
  id               String        @id @default(uuid()) @db.Uuid
  cargaId          String        @map("carga_id") @db.Uuid
  tipo             CargaItemTipo @default(PALLET)
  palletDespachoId String?       @unique @map("pallet_despacho_id") @db.Uuid
  escaneadoAt      DateTime?     @map("escaneado_at")
  escaneadoPorId   String?       @map("escaneado_por_id") @db.Uuid
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")

  carga          Carga          @relation(fields: [cargaId], references: [id], onDelete: Restrict)
  palletDespacho PalletDespacho? @relation(fields: [palletDespachoId], references: [id], onDelete: Restrict)
  escaneadoPor   User?          @relation("CargaItemEscaneadoPor", fields: [escaneadoPorId], references: [id], onDelete: SetNull)

  @@index([cargaId, isActive])
  @@map("carga_items")
}

model DespachoManifiesto {
  id                  String   @id @default(uuid()) @db.Uuid
  despachoId          String   @unique @map("despacho_id") @db.Uuid
  origenNombre        String   @map("origen_nombre")
  destinoNombre       String   @map("destino_nombre")
  vehiculoPlaca       String?  @map("vehiculo_placa")
  conductorNombre     String?  @map("conductor_nombre")
  transportistaNombre String?  @map("transportista_nombre")
  palletsCount        Int      @map("pallets_count")
  kitsCount           Int      @map("kits_count")
  pesoKg              Decimal  @map("peso_kg") @db.Decimal(14, 3)
  volumenM3           Decimal? @map("volumen_m3") @db.Decimal(14, 3)
  generadoAt          DateTime @default(now()) @map("generado_at")

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Restrict)

  @@map("despacho_manifiestos")
}

model DespachoChecklist {
  id                    String    @id @default(uuid()) @db.Uuid
  despachoId            String    @unique @map("despacho_id") @db.Uuid
  cargaCompleta         Boolean   @default(false) @map("carga_completa")
  palletsIdentificados  Boolean   @default(false) @map("pallets_identificados")
  pesoVerificado        Boolean   @default(false) @map("peso_verificado")
  destinoConfirmado     Boolean   @default(false) @map("destino_confirmado")
  vehiculoConfirmado    Boolean   @default(false) @map("vehiculo_confirmado")
  conductorConfirmado   Boolean   @default(false) @map("conductor_confirmado")
  documentacionCompleta Boolean   @default(false) @map("documentacion_completa")
  sellosRegistrados     Boolean   @default(false) @map("sellos_registrados")
  confirmadoAt          DateTime? @map("confirmado_at")
  confirmadoPorId       String?   @map("confirmado_por_id") @db.Uuid

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Restrict)

  @@map("despacho_checklists")
}

model ProofOfDelivery {
  id                 String         @id @default(uuid()) @db.Uuid
  viajeId            String?        @unique @map("viaje_id") @db.Uuid
  despachoId         String?        @map("despacho_id") @db.Uuid
  estado             EntregaEstado  @default(PENDIENTE)
  receivedBy         String?        @map("received_by")
  receiverDocument   String?        @map("receiver_document")
  cantidadEsperada   Int?           @map("cantidad_esperada")
  cantidadRecibida   Int?           @map("cantidad_recibida")
  cantidadDanada     Int            @default(0) @map("cantidad_danada")
  cantidadFaltante   Int            @default(0) @map("cantidad_faltante")
  cantidadDevuelta   Int            @default(0) @map("cantidad_devuelta")
  observaciones      String?
  firmaUrl           String?        @map("firma_url")
  fotoUrl            String?        @map("foto_url")
  lat                Float?
  lng                Float?
  entregadoAt        DateTime?      @map("entregado_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  viaje    Viaje?    @relation(fields: [viajeId], references: [id], onDelete: Restrict)
  despacho Despacho? @relation(fields: [despachoId], references: [id], onDelete: SetNull)

  @@index([despachoId])
  @@map("proof_of_delivery")
}

model ConsolidacionKit {
  id               String @id @default(uuid()) @db.Uuid
  consolidacionId  String @map("consolidacion_id") @db.Uuid
  kitInstanciaId   String @unique @map("kit_instancia_id") @db.Uuid
  isActive         Boolean @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  consolidacion Consolidacion @relation(fields: [consolidacionId], references: [id], onDelete: Restrict)
  kitInstancia  KitInstancia  @relation(fields: [kitInstanciaId], references: [id], onDelete: Restrict)

  @@index([consolidacionId])
  @@map("consolidacion_kits")
}
