  @@unique([organizationId, codigo])
  @@index([reservaId, estado])
  @@index([demandaId, estado])
  @@map("kit_instancias")
}

model KitInstanciaItem {
  id                 String    @id @default(uuid()) @db.Uuid
  kitInstanciaId     String    @map("kit_instancia_id") @db.Uuid
  productoId         String    @map("producto_id") @db.Uuid
  inventoryItemId    String?   @map("inventory_item_id") @db.Uuid
  origenUbicacionId  String?   @map("origen_ubicacion_id") @db.Uuid
