generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationTipo {
  CENTRO_ACOPIO
  RESCATE
  OLLA_COMUNITARIA
  INSTITUCION
  OTRO
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  usuario             String    @unique
  correo              String    @unique
  nombre              String
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  isActive            Boolean   @default(true) @map("is_active")
  correoVerificadoAt  DateTime? @map("correo_verificado_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  memberships          Membership[]
  imagenesSubidas      DonacionImagen[]
  emailVerifications   EmailVerification[]
  recepciones          Recepcion[]
  movimientos          InventoryMovimiento[]
  putawaysCreados      Putaway[]             @relation("PutawayCreado")
  putawaysConfirmados  Putaway[]             @relation("PutawayConfirmado")

  @@map("users")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  codigoHash String    @map("codigo_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  lastSentAt DateTime  @default(now()) @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model CaptchaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  answerHash String    @map("answer_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("captcha_challenges")
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  nombre      String
  correo      String
  telefono    String?
  descripcion String?
  tipo        OrganizationTipo
  tipoDetalle String?          @map("tipo_detalle")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  memberships Membership[]
  acopios     Acopio[]
  imagenes    DonacionImagen[]
  recepciones Recepcion[]
  lotes       Lote[]
  counters    OrgCounter[]
  movimientos InventoryMovimiento[]
  putaways    Putaway[]

  @@map("organizations")
}

enum AcopioFlujo {
  RECIBIR
  ENVIAR
  AMBOS
}

model Acopio {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  nombre         String
  flujo          AcopioFlujo @default(AMBOS)
  telefono       String?
  descripcion    String?
  departamento   String?
  municipio      String?
  direccion      String?
  lat            Float?
  lng            Float?
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]
  imagenes       DonacionImagen[]
  recepciones    Recepcion[]
  ubicaciones    Ubicacion[]
  movimientos    InventoryMovimiento[]
  putaways       Putaway[]

  @@index([organizationId])
  @@map("acopios")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nombre      String
  descripcion String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nombre      String
  descripcion String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum InventoryCategoria {
  ALIMENTOS_NO_PERECEDEROS
  AGUA
  ASEO_HIGIENE
  PANALES_BEBE
  MEDICAMENTOS
  ROPA_CALZADO
  COLCHONETAS_COBIJAS
  ALIMENTO_MASCOTAS
  MEDICAMENTO_MASCOTAS
  LOGISTICA_RESCATE
  MENAJE_COCINA
  DESECHABLES
  OTRO
}

enum InventoryUnidad {
  UNIDAD
  LIBRA
  KILO
  LITRO
  BOTELLA
  LATA
  PAQUETE
  CAJA
  GALON
  FRASCO
  TABLETA
  DOCENA
  OTRO
}

enum InventoryEstado {
  NUEVO
  BUEN_ESTADO
  USADO
  PROXIMO_A_VENCER
  VENCIDO
  NO_APLICA
}

enum InventoryDestinatario {
  NO_APLICA
  UNISEX
  MUJER
  HOMBRE
  NINO
  NINA
  BEBE
  MASCOTA
}

model InventoryItem {
  id                String               @id @default(uuid()) @db.Uuid
  acopioId          String               @map("acopio_id") @db.Uuid
  nombre            String
  categoria         InventoryCategoria
  categoriaDetalle  String?              @map("categoria_detalle")
  sku               String?
  marca             String?
  presentacion      String?
  talla             String?
  destinatario      InventoryDestinatario @default(NO_APLICA)
  cantidad          Decimal              @db.Decimal(14, 3)
  unidad            InventoryUnidad
  unidadDetalle     String?              @map("unidad_detalle")
  vencimiento       DateTime?            @db.Date
  estado            InventoryEstado      @default(BUEN_ESTADO)
  loteCodigo        String?              @map("lote_codigo")
  ubicacionInterna  String?              @map("ubicacion_interna")
  donanteNombre     String?              @map("donante_nombre")
  donanteContacto   String?              @map("donante_contacto")
  observaciones     String?
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  productoId        String?              @map("producto_id") @db.Uuid
  loteId            String?              @map("lote_id") @db.Uuid

  acopio         Acopio          @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  donaciones     DonacionImagen[]
  producto       Producto?       @relation(fields: [productoId], references: [id], onDelete: SetNull)
  lote           Lote?           @relation(fields: [loteId], references: [id], onDelete: SetNull)
  recepcionItems RecepcionItem[]
  balances       InventoryBalance[]
  movimientos    InventoryMovimiento[]
  putaways       Putaway[]

  @@index([acopioId])
  @@index([acopioId, categoria])
  @@index([acopioId, nombre])
  @@index([acopioId, isActive])
  @@index([acopioId, productoId, loteId])
  @@map("inventory_items")
}

enum DonacionImagenEstado {
  PENDIENTE
  PROCESANDO
  PROCESADA
  FALLIDA
}

/// Catálogo maestro global. Un EAN = una fila. El SKU lo genera el sistema.
model Producto {
  id                   String              @id @default(uuid()) @db.Uuid
  sku                  String              @unique
  nombre               String
  marca                String?
  /// Etiqueta libre legado del seed (`Alimentos`). No es la clave de negocio.
  categoria            String?
  categoriaInventario  InventoryCategoria  @default(OTRO) @map("categoria_inventario")
  ean                  String?             @unique
  alias                String[]            @default([])
  unidadBase           InventoryUnidad     @default(UNIDAD) @map("unidad_base")
  presentacion         String?
  requiereLote         Boolean             @default(false) @map("requiere_lote")
  requiereVencimiento  Boolean             @default(false) @map("requiere_vencimiento")
  esPerecedero         Boolean             @default(false) @map("es_perecedero")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  imagenes       DonacionImagen[]
  lotes          Lote[]
  recepcionItems RecepcionItem[]
  inventoryItems InventoryItem[]

  @@index([marca])
  @@index([isActive])
  @@map("productos")
}

/// Una foto de un producto donado. La sube la PWA directo a Vercel Blob y el
/// worker la procesa de forma asíncrona.
model DonacionImagen {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  acopioId       String? @map("acopio_id") @db.Uuid
  subidaPorId    String  @map("subida_por_id") @db.Uuid

  blobUrl      String @map("blob_url")
  blobPathname String @unique @map("blob_pathname")

  estado   DonacionImagenEstado @default(PENDIENTE)
  intentos Int                  @default(0)
  error    String?

  /// Texto crudo que devolvió el OCR, útil para depurar y reprocesar.
  textoOcr   String? @map("texto_ocr")
  /// Confianza del reconocimiento, 0..1.
  confianza  Float?
  /// Sugerencia para que el operador confirme (no entra al inventario sola).
  nombreDetectado    String?   @map("nombre_detectado")
  cantidadDetectada  Decimal?  @map("cantidad_detectada") @db.Decimal(14, 3)
  confirmadaEn       DateTime? @map("confirmada_en")
  inventoryItemId    String?   @map("inventory_item_id") @db.Uuid
  productoId         String?   @map("producto_id") @db.Uuid
  recepcionItemId    String?   @map("recepcion_item_id") @db.Uuid

  procesadaEn DateTime? @map("procesada_en")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio        Acopio?        @relation(fields: [acopioId], references: [id], onDelete: SetNull)
  subidaPor     User           @relation(fields: [subidaPorId], references: [id], onDelete: Restrict)
  producto      Producto?      @relation(fields: [productoId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  recepcionItem RecepcionItem? @relation(fields: [recepcionItemId], references: [id], onDelete: SetNull)

  @@index([organizationId, estado])
  @@index([estado])
  @@index([recepcionItemId])
  @@map("donacion_imagenes")
}

enum RecepcionTipo {
  DONACION_INDIVIDUAL
  DONACION_MASIVA
  TRANSFERENCIA
  COMPRA
  DEVOLUCION
  REUBICACION
  OTRO
}

enum RecepcionPresentacion {
  SUELTA
  CAJAS
  BULTOS
  PALLETS
  CONTENEDORES
  MIXTA
}

enum RecepcionEstado {
  BORRADOR
  EN_RECEPCION
  EN_INSPECCION
  PENDIENTE_VALIDACION
  VALIDADA
  CERRADA
  ANULADA
}

enum UnidadLogisticaTipo {
  PALLET
  CAJA
  BULTO
  SACO
  CONTENEDOR
  CANECA
  BOLSA
  PAQUETE
  OTRO
}

enum UnidadLogisticaEstado {
  RECIBIDA
  ABIERTA
  VACIA
}

enum RecepcionItemEstado {
  PENDIENTE_ID
  IDENTIFICADA
  INSPECCIONADA
  VALIDADA
}

/// Contadores humanos (REC, PAL, LOT, SKU). `organization_id` null = catálogo global.
model OrgCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  kind           String
  periodo        String   @default("")
  siguiente      Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("org_counters")
}

model Recepcion {
  id                   String                 @id @default(uuid()) @db.Uuid
  codigo               String
  organizationId       String                 @map("organization_id") @db.Uuid
  acopioId             String                 @map("acopio_id") @db.Uuid
  tipo                 RecepcionTipo
  presentacionFisica   RecepcionPresentacion  @map("presentacion_fisica")
  estado               RecepcionEstado        @default(EN_RECEPCION)
  recibidaEn           DateTime               @default(now()) @map("recibida_en")
  donanteNombre        String?                @map("donante_nombre")
  donanteContacto      String?                @map("donante_contacto")
  procedencia          String?
  transportista        String?
  vehiculoPlaca        String?                @map("vehiculo_placa")
  documentoTransporte  String?                @map("documento_transporte")
  observaciones        String?
  responsableId        String                 @map("responsable_id") @db.Uuid
  validadaEn           DateTime?              @map("validada_en")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio           Acopio            @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  responsable      User              @relation(fields: [responsableId], references: [id], onDelete: Restrict)
  unidades         UnidadLogistica[]
  items            RecepcionItem[]

  @@unique([organizationId, codigo])
  @@index([organizationId, createdAt])
  @@index([acopioId])
  @@index([organizationId, estado])
  @@map("recepciones")
}

model UnidadLogistica {
  id              String                 @id @default(uuid()) @db.Uuid
  codigo          String
  nroEnRecepcion  Int                    @map("nro_en_recepcion")
  recepcionId     String                 @map("recepcion_id") @db.Uuid
  tipo            UnidadLogisticaTipo
  parentId        String?                @map("parent_id") @db.Uuid
  estado          UnidadLogisticaEstado  @default(RECIBIDA)
  observaciones   String?
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  recepcion Recepcion         @relation(fields: [recepcionId], references: [id], onDelete: Restrict)
  parent    UnidadLogistica?  @relation("UlArbol", fields: [parentId], references: [id], onDelete: SetNull)
  children  UnidadLogistica[] @relation("UlArbol")
  items     RecepcionItem[]

  @@unique([recepcionId, nroEnRecepcion])
  @@index([recepcionId])
  @@index([codigo])
  @@map("unidades_logisticas")
}

model Lote {
  id             String    @id @default(uuid()) @db.Uuid
  codigo         String
  codigoOrigen   String?   @map("codigo_origen")
  productoId     String    @map("producto_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  vencimiento    DateTime? @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  producto       Producto        @relation(fields: [productoId], references: [id], onDelete: Restrict)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recepcionItems RecepcionItem[]
  inventoryItems InventoryItem[]

  @@unique([organizationId, codigo])
  @@index([productoId])
  @@index([organizationId])
  @@map("lotes")
}

model RecepcionItem {
  id                  String               @id @default(uuid()) @db.Uuid
  recepcionId         String               @map("recepcion_id") @db.Uuid
  unidadLogisticaId   String?              @map("unidad_logistica_id") @db.Uuid
  productoId          String?              @map("producto_id") @db.Uuid
  loteId              String?              @map("lote_id") @db.Uuid
  inventoryItemId     String?              @map("inventory_item_id") @db.Uuid
  cantidadRecibida    Decimal              @map("cantidad_recibida") @db.Decimal(14, 3)
  cantidadAprobada    Decimal              @default(0) @map("cantidad_aprobada") @db.Decimal(14, 3)
  cantidadCuarentena  Decimal              @default(0) @map("cantidad_cuarentena") @db.Decimal(14, 3)
  cantidadRechazada   Decimal              @default(0) @map("cantidad_rechazada") @db.Decimal(14, 3)
  unidad              InventoryUnidad      @default(UNIDAD)
  pesoKg              Decimal?             @map("peso_kg") @db.Decimal(14, 3)
  estadoLinea         RecepcionItemEstado  @default(PENDIENTE_ID) @map("estado_linea")
  observaciones       String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  recepcion       Recepcion        @relation(fields: [recepcionId], references: [id], onDelete: Restrict)
  unidadLogistica UnidadLogistica? @relation(fields: [unidadLogisticaId], references: [id], onDelete: SetNull)
  producto        Producto?        @relation(fields: [productoId], references: [id], onDelete: SetNull)
  lote            Lote?            @relation(fields: [loteId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  imagenes        DonacionImagen[]

  @@index([recepcionId])
  @@index([productoId])
  @@index([unidadLogisticaId])
  @@map("recepcion_items")
}

/// Nivel físico en el árbol (zona → pasillo → rack → …). No todas las bodegas
/// usan todos los niveles: una chica puede parar en ZONA.
enum UbicacionTipo {
  ZONA
  PASILLO
  RACK
  NIVEL
  POSICION
  OTRO
}

/// Para qué sirve el nodo. Un inventario aprobado va a ALMACENAMIENTO, no a
/// RECHAZADO ni a CUARENTENA.
enum UbicacionFuncion {
  RECEPCION
  CUARENTENA
  ALMACENAMIENTO
  PICKING
  KITTING
  DESPACHO
  DEVOLUCION
  RECHAZADO
}

enum UbicacionEstado {
  ACTIVA
  INACTIVA
  BLOQUEADA
  MANTENIMIENTO
}

enum InventoryMovimientoTipo {
  RECEPCION
  PUTAWAY
  REUBICACION
  AJUSTE
}

enum PutawayEstado {
  PENDIENTE
  COMPLETADO
  ANULADO
}

/// Lugar físico (o zona) dentro de un acopio. Jerárquico vía parent_id.
model Ubicacion {
  id                   String           @id @default(uuid()) @db.Uuid
  acopioId             String           @map("acopio_id") @db.Uuid
  parentId             String?          @map("parent_id") @db.Uuid
  codigo               String
  nombre               String
  tipo                 UbicacionTipo
  funcion              UbicacionFuncion
  estado               UbicacionEstado  @default(ACTIVA)
  capacidadPesoKg      Decimal?         @map("capacidad_peso_kg") @db.Decimal(14, 3)
  capacidadVolumen     Decimal?         @map("capacidad_volumen") @db.Decimal(14, 3)
  capacidadUnidades    Decimal?         @map("capacidad_unidades") @db.Decimal(14, 3)
  zonaTemperatura      String?          @map("zona_temperatura")
  permiteAlimentos     Boolean          @default(true) @map("permite_alimentos")
  permiteMedicamentos  Boolean          @default(true) @map("permite_medicamentos")
  permiteRopa          Boolean          @default(true) @map("permite_ropa")
  /// Muelle / cuarentena de sistema: no se dan de baja a mano.
  esSistema            Boolean          @default(false) @map("es_sistema")
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  acopio   Acopio      @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  parent   Ubicacion?  @relation("UbicacionArbol", fields: [parentId], references: [id], onDelete: SetNull)
  children Ubicacion[] @relation("UbicacionArbol")

  balances            InventoryBalance[]
  movimientosOrigen   InventoryMovimiento[] @relation("MovimientoOrigen")
  movimientosDestino  InventoryMovimiento[] @relation("MovimientoDestino")
  putawayOrigen       PutawayLinea[]        @relation("PutawayOrigen")
  putawayDestino      PutawayLinea[]        @relation("PutawayDestino")

  @@unique([acopioId, codigo])
  @@index([acopioId, estado])
  @@index([acopioId, funcion])
  @@index([parentId])
  @@map("ubicaciones")
}

/// Cuánto de un ítem está hoy en una ubicación. Un inventario puede partirse.
model InventoryBalance {
  id              String   @id @default(uuid()) @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  ubicacionId     String   @map("ubicacion_id") @db.Uuid
  cantidad        Decimal  @db.Decimal(14, 3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  ubicacion     Ubicacion     @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)

  @@unique([inventoryItemId, ubicacionId])
  @@index([ubicacionId])
  @@map("inventory_balances")
}

/// Historial: nunca se cambia un saldo sin dejar movimiento.
model InventoryMovimiento {
  id                 String                   @id @default(uuid()) @db.Uuid
  codigo             String
  organizationId     String                   @map("organization_id") @db.Uuid
  acopioId           String                   @map("acopio_id") @db.Uuid
  inventoryItemId    String                   @map("inventory_item_id") @db.Uuid
  tipo               InventoryMovimientoTipo
  cantidad           Decimal                  @db.Decimal(14, 3)
  origenUbicacionId  String?                  @map("origen_ubicacion_id") @db.Uuid
  destinoUbicacionId String?                  @map("destino_ubicacion_id") @db.Uuid
  putawayId          String?                  @map("putaway_id") @db.Uuid
  usuarioId          String                   @map("usuario_id") @db.Uuid
  observaciones      String?
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio           Acopio        @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  origenUbicacion  Ubicacion?    @relation("MovimientoOrigen", fields: [origenUbicacionId], references: [id], onDelete: SetNull)
  destinoUbicacion Ubicacion?    @relation("MovimientoDestino", fields: [destinoUbicacionId], references: [id], onDelete: SetNull)
  putaway          Putaway?      @relation(fields: [putawayId], references: [id], onDelete: SetNull)
  usuario          User          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@unique([organizationId, codigo])
  @@index([inventoryItemId, createdAt])
  @@index([acopioId, createdAt])
  @@map("inventory_movimientos")
}

/// Tarea de llevar mercancía del muelle a almacenamiento. Completarla exige
/// confirmar el código de la ubicación destino (el sistema no ubica solo).
model Putaway {
  id              String         @id @default(uuid()) @db.Uuid
  codigo          String
  organizationId  String         @map("organization_id") @db.Uuid
  acopioId        String         @map("acopio_id") @db.Uuid
  inventoryItemId String         @map("inventory_item_id") @db.Uuid
  estado          PutawayEstado  @default(PENDIENTE)
  createdById     String         @map("created_by_id") @db.Uuid
  confirmedById   String?        @map("confirmed_by_id") @db.Uuid
  confirmedAt     DateTime?      @map("confirmed_at")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio        Acopio        @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("PutawayCreado", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy   User?         @relation("PutawayConfirmado", fields: [confirmedById], references: [id], onDelete: SetNull)
  lineas        PutawayLinea[]
  movimientos   InventoryMovimiento[]

  @@unique([organizationId, codigo])
  @@index([acopioId, estado])
  @@index([inventoryItemId])
  @@map("putaways")
}

model PutawayLinea {
  id                 String        @id @default(uuid()) @db.Uuid
  putawayId          String        @map("putaway_id") @db.Uuid
  origenUbicacionId  String        @map("origen_ubicacion_id") @db.Uuid
  destinoUbicacionId String        @map("destino_ubicacion_id") @db.Uuid
  cantidad           Decimal       @db.Decimal(14, 3)
  estado             PutawayEstado @default(PENDIENTE)
  confirmedAt        DateTime?     @map("confirmed_at")
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at")

  putaway          Putaway   @relation(fields: [putawayId], references: [id], onDelete: Restrict)
  origenUbicacion  Ubicacion @relation("PutawayOrigen", fields: [origenUbicacionId], references: [id], onDelete: Restrict)
  destinoUbicacion Ubicacion @relation("PutawayDestino", fields: [destinoUbicacionId], references: [id], onDelete: Restrict)

  @@index([putawayId])
  @@map("putaway_lineas")
}
