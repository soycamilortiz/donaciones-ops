generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationTipo {
  CENTRO_ACOPIO
  RESCATE
  OLLA_COMUNITARIA
  INSTITUCION
  OTRO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  usuario      String   @unique
  correo       String   @unique
  nombre       String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("users")
}

model CaptchaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  answerHash String    @map("answer_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("captcha_challenges")
}

model Organization {
  id          String            @id @default(uuid()) @db.Uuid
  nombre      String
  correo      String
  telefono    String?
  descripcion String?
  tipo        OrganizationTipo
  tipoDetalle String?           @map("tipo_detalle")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  memberships Membership[]
  acopios     Acopio[]

  @@map("organizations")
}

enum AcopioFlujo {
  RECIBIR
  ENVIAR
  AMBOS
}

model Acopio {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  nombre         String
  flujo          AcopioFlujo  @default(AMBOS)
  telefono       String?
  descripcion    String?
  municipio      String?
  direccion      String?
  lat            Float?
  lng            Float?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@index([organizationId])
  @@map("acopios")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nombre      String
  descripcion String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nombre      String
  descripcion String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum InventoryCategoria {
  ALIMENTOS_NO_PERECEDEROS
  AGUA
  ASEO_HIGIENE
  PANALES_BEBE
  MEDICAMENTOS
  ROPA_CALZADO
  COLCHONETAS_COBIJAS
  ALIMENTO_MASCOTAS
  MEDICAMENTO_MASCOTAS
  LOGISTICA_RESCATE
  MENAJE_COCINA
  DESECHABLES
  OTRO
}

enum InventoryUnidad {
  UNIDAD
  LIBRA
  KILO
  LITRO
  BOTELLA
  LATA
  PAQUETE
  CAJA
  GALON
  FRASCO
  TABLETA
  DOCENA
  OTRO
}

enum InventoryEstado {
  NUEVO
  BUEN_ESTADO
  USADO
  PROXIMO_A_VENCER
  VENCIDO
  NO_APLICA
}

enum InventoryDestinatario {
  NO_APLICA
  UNISEX
  MUJER
  HOMBRE
  NINO
  NINA
  BEBE
  MASCOTA
}

model InventoryItem {
  id                String               @id @default(uuid()) @db.Uuid
  acopioId          String               @map("acopio_id") @db.Uuid
  nombre            String
  categoria         InventoryCategoria
  categoriaDetalle  String?              @map("categoria_detalle")
  sku               String?
  marca             String?
  presentacion      String?
  talla             String?
  destinatario      InventoryDestinatario @default(NO_APLICA)
  cantidad          Decimal              @db.Decimal(14, 3)
  unidad            InventoryUnidad
  unidadDetalle     String?              @map("unidad_detalle")
  vencimiento       DateTime?            @db.Date
  estado            InventoryEstado      @default(BUEN_ESTADO)
  loteCodigo        String?              @map("lote_codigo")
  ubicacionInterna  String?              @map("ubicacion_interna")
  donanteNombre     String?              @map("donante_nombre")
  donanteContacto   String?              @map("donante_contacto")
  observaciones     String?
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  acopio Acopio @relation(fields: [acopioId], references: [id], onDelete: Restrict)

  @@index([acopioId])
  @@index([acopioId, categoria])
  @@index([acopioId, nombre])
  @@index([acopioId, isActive])
  @@map("inventory_items")
}
