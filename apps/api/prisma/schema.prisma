generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationTipo {
  CENTRO_ACOPIO
  RESCATE
  OLLA_COMUNITARIA
  INSTITUCION
  OTRO
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  usuario      String   @unique
  correo       String   @unique
  nombre       String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  imagenesSubidas DonacionImagen[]

  @@map("users")
}

model CaptchaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  answerHash String    @map("answer_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("captcha_challenges")
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  nombre      String
  correo      String
  telefono    String?
  descripcion String?
  tipo        OrganizationTipo
  tipoDetalle String?          @map("tipo_detalle")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  memberships Membership[]
  acopios     Acopio[]
  imagenes    DonacionImagen[]

  @@map("organizations")
}

enum AcopioFlujo {
  RECIBIR
  ENVIAR
  AMBOS
}

model Acopio {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  nombre         String
  flujo          AcopioFlujo @default(AMBOS)
  telefono       String?
  descripcion    String?
  municipio      String?
  direccion      String?
  lat            Float?
  lng            Float?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  imagenes     DonacionImagen[]

  @@index([organizationId])
  @@map("acopios")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  nombre      String
  descripcion String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

enum DonacionImagenEstado {
  PENDIENTE
  PROCESANDO
  PROCESADA
  FALLIDA
}

/// Catálogo contra el que el worker intenta resolver el texto que saca del OCR.
/// `ean` queda listo para cuando se lea el código de barras desde la PWA.
model Producto {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  marca     String?
  categoria String?
  ean       String?  @unique
  /// Términos que, si aparecen en el texto reconocido, apuntan a este producto.
  alias     String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  imagenes DonacionImagen[]

  @@index([marca])
  @@map("productos")
}

/// Una foto de un producto donado. La sube la PWA directo a Vercel Blob y el
/// worker la procesa de forma asíncrona.
model DonacionImagen {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  acopioId       String? @map("acopio_id") @db.Uuid
  subidaPorId    String  @map("subida_por_id") @db.Uuid

  blobUrl      String @map("blob_url")
  blobPathname String @unique @map("blob_pathname")

  estado   DonacionImagenEstado @default(PENDIENTE)
  intentos Int                  @default(0)
  error    String?

  /// Texto crudo que devolvió el OCR, útil para depurar y reprocesar.
  textoOcr   String? @map("texto_ocr")
  /// Confianza del reconocimiento, 0..1.
  confianza  Float?
  /// Null si no se pudo identificar: queda para revisión manual.
  productoId String? @map("producto_id") @db.Uuid

  procesadaEn DateTime? @map("procesada_en")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acopio       Acopio?      @relation(fields: [acopioId], references: [id], onDelete: SetNull)
  subidaPor    User         @relation(fields: [subidaPorId], references: [id], onDelete: Restrict)
  producto     Producto?    @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([organizationId, estado])
  @@index([estado])
  @@map("donacion_imagenes")
}
