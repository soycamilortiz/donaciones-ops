  updatedAt        DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acopio       Acopio       @relation(fields: [acopioId], references: [id], onDelete: Restrict)
  demanda      Demanda      @relation(fields: [demandaId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  kits              ConsolidacionKit[]
  planPalletizacion PlanPalletizacion?

  @@unique([organizationId, codigo])
  @@index([demandaId, estado])
  @@map("consolidaciones")
}

