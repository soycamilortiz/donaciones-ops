NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://soschoco:soschoco@localhost:5432/soschoco
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://soschoco.localhost,http://localhost:5173
JWT_SECRET=soschoco-dev-jwt-secret-cambia-esto
JWT_EXPIRES_IN=8h
REDIS_URL=redis://localhost:6379
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2. El secret solo vive en el API/worker.
# Health: GET /api/health/storage (HeadBucket). Endpoint S3 sin /bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sos-choco
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Open Food Facts (lookup EAN). No pide API key; el User-Agent es obligatorio.
# Docs: https://openfoodfacts.github.io/openfoodfacts-server/api/
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=SOSChoco/1.0 (contacto@soschoco.local)
OPEN_FOOD_FACTS_TIMEOUT_MS=8000

# Visión (`@soschoco/vision`). Sin VISION_API_KEY el operador completa a mano.
# provider: openai (Chat Completions) | noop
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_MS=45000

# En serverless (Vercel) ponlos en false: el arranque en frio ocurre muchas
# veces al dia y ambos pasos son caros. Ver apps/api/README.md.
RBAC_SYNC_ON_BOOT=true
SWAGGER_ENABLED=true
