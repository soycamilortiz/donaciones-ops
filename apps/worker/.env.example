NODE_ENV=development
DATABASE_URL=postgresql://soschoco:soschoco@localhost:5432/soschoco
REDIS_URL=redis://localhost:6379

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sos-choco
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Cuántas imágenes procesa en paralelo este proceso
OCR_CONCURRENCIA=2
# Reintentos antes de marcar la imagen FALLIDA
OCR_MAX_INTENTOS=3
# Corta el proceso de Tesseract si se pasa de este tiempo
OCR_TIMEOUT_MS=30000
# Idiomas de Tesseract, separados por '+'
OCR_IDIOMAS=spa+eng
# Por debajo de esta confianza la imagen queda sin producto, para revisión manual
OCR_CONFIANZA_MINIMA=0.6
