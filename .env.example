POSTGRES_USER=soschoco
POSTGRES_PASSWORD=soschoco
POSTGRES_DB=soschoco
POSTGRES_PORT=5432
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://soschoco.localhost
JWT_SECRET=soschoco-dev-jwt-secret-cambia-esto
JWT_EXPIRES_IN=8h

# Cola de reconocimiento de imágenes (apps/worker)
# En Docker Compose el API/worker usan redis://redis:6379 (hostname del servicio).
# En el host: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Token de escritura de Vercel Blob (flujo actual). Sin él, donaciones responde 503.
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 (fotos). Keys: R2 → Manage R2 API Tokens → Create API token.
# Endpoint S3 SIN el nombre del bucket. Comprobar: GET /api/health/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sos-choco
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Custom domain en prod, o Public Development URL (r2.dev) en local
R2_PUBLIC_BASE_URL=
OCR_CONCURRENCIA=2
OCR_MAX_INTENTOS=3
OCR_TIMEOUT_MS=30000
OCR_IDIOMAS=spa+eng
OCR_CONFIANZA_MINIMA=0.6

# Panel de observacion de la cola (apps/jobs) — http://localhost/jobs
JOBS_USER=admin
JOBS_PASSWORD=cambia-esta-clave
