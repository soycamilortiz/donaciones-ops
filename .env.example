POSTGRES_USER=soschoco
POSTGRES_PASSWORD=soschoco
POSTGRES_DB=soschoco
POSTGRES_PORT=5432
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://soschoco.localhost
JWT_SECRET=soschoco-dev-jwt-secret-cambia-esto
JWT_EXPIRES_IN=8h

# Cola de reconocimiento de imágenes (apps/worker)
# En Docker Compose el API/worker usan redis://redis:6379 (hostname del servicio).
# En el host: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Token de escritura de Vercel Blob. Sin él, el módulo de donaciones responde 503.
BLOB_READ_WRITE_TOKEN=
OCR_CONCURRENCIA=2
OCR_MAX_INTENTOS=3
OCR_TIMEOUT_MS=30000
OCR_IDIOMAS=spa+eng
OCR_CONFIANZA_MINIMA=0.6

# Panel de observacion de la cola (apps/jobs) — http://localhost/jobs
JOBS_USER=admin
JOBS_PASSWORD=cambia-esta-clave
