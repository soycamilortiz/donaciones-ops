# Variables para `docker compose`. Copia este archivo a `.env`.
#
# IMPORTANTE: las URL de conexión NO se ponen aquí.
# El compose las arma solo con los nombres de servicio de la red `soschoco`:
#
#   DATABASE_URL = postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
#   REDIS_URL    = redis://redis:6379
#
# Dentro de Docker nadie usa `localhost`: `postgres` y `redis` son nombres DNS
# que resuelve la red interna. Lo que se configura aquí son credenciales y
# secretos; las direcciones se derivan de ellos.

# --- PostgreSQL -------------------------------------------------------------
# Cambiar el usuario o la contraseña actualiza la DATABASE_URL de api y worker
# automáticamente, porque el compose la construye a partir de estas.
POSTGRES_USER=soschoco
POSTGRES_PASSWORD=soschoco
POSTGRES_DB=soschoco
# Solo expone el puerto al host, para conectarte con psql o Prisma Studio.
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
CORS_ORIGIN=http://localhost,http://127.0.0.1,http://soschoco.localhost
# Mínimo 16 caracteres. Cámbialo antes de cualquier entorno real.
JWT_SECRET=soschoco-dev-jwt-secret-cambia-esto
JWT_EXPIRES_IN=8h

# Cola de reconocimiento. En Docker el compose la fija a redis://redis:6379
# (nombre del servicio); esta variable solo aplica al correr las apps en el host.
REDIS_URL=redis://localhost:6379
# Solo expone el puerto al host, para conectarte con redis-cli.
REDIS_PORT=6379
# Token de escritura de Vercel Blob (flujo actual). Sin él, donaciones responde 503.
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 (fotos). Keys: R2 → Manage R2 API Tokens → Create API token.
# Endpoint S3 SIN el nombre del bucket. Comprobar: GET /api/health/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sos-choco
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Custom domain en prod, o Public Development URL (r2.dev) en local
R2_PUBLIC_BASE_URL=

# Open Food Facts (código de barras). El User-Agent identifica la app; no es un secreto.
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=SOSChoco/1.0 (contacto@soschoco.local)
OPEN_FOOD_FACTS_TIMEOUT_MS=8000

# Visión (`@soschoco/vision`). Sin clave, si no hay EAN se completa a mano.
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_MS=45000

# --- Worker de reconocimiento (apps/worker) ---------------------------------
OCR_CONCURRENCIA=2
OCR_MAX_INTENTOS=3
OCR_TIMEOUT_MS=30000
OCR_IDIOMAS=spa+eng
# Por debajo de esta certeza la foto queda sin producto, para revisión manual.
OCR_CONFIANZA_MINIMA=0.6

# --- Panel de la cola (apps/jobs) — http://localhost/jobs -------------------
JOBS_USER=admin
JOBS_PASSWORD=cambia-esta-clave
