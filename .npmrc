# pnpm — monorepo donaciones-ops
auto-install-peers=true
strict-peer-dependencies=false

# NestJS/Prisma resuelven binarios y metadata de decoradores desde node_modules,
# así que dejamos accesibles los paquetes hoisted que esperan encontrar por nombre.
public-hoist-pattern[]=*@nestjs/cli*
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=*@prisma/*
